# Coach API (Cloudflare Worker → free Groq/Llama)
# Never put GROQ_API_KEY here — browser-visible. Key stays on the worker only.
# Deploy: see coach-api/README.md
# Example: https://astronavigator-coach.<account>.workers.dev
VITE_COACH_API_URL=

# Telegram Stars pay bot (username without @)
# Enables deep-links: t.me/<bot>?start=buy_year
VITE_TELEGRAM_BOT_USERNAME=Sacrum_lab_bot

# Pay bot Worker base URL (claim signed unlock tokens)
# Example: https://astronavigator-pay-bot.<account>.workers.dev
VITE_PAY_API_URL=

# --- Admin / developer full access ---
# Birth date 1991-03-07 (Андрей) → lifetime (Pro + Year + unlimited helper).
# Enabled by default in all builds. Kill-switch only if you must remove it:
# VITE_DISABLE_ADMIN_UNLOCK=true
# Optional extra session secret (Settings UI for candidate birth dates):
# VITE_ADMIN_SESSION_SECRET=change-me-long-random
